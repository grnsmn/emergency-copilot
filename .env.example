# Copy this file to .env and fill in your Supabase project values.
# These are safe to expose in the client bundle (EXPO_PUBLIC_* vars are
# public by design in Expo). Never put service_role keys or other secrets
# here — those belong in Supabase Edge Function secrets, set via
# `supabase secrets set`, never in this repo.

EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
