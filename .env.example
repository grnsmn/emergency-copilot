# Copy to .env (cloud) and/or .env.local (local Supabase, takes precedence).
# EXPO_PUBLIC_* values end up in the client bundle: only public keys here.
# Never put secret / service_role keys or the DB password in these files —
# server secrets belong in `supabase secrets set`.
#
# Local values: printed by `npx supabase start` (API_URL, PUBLISHABLE_KEY).
# Cloud values: Supabase dashboard → Project Settings → API Keys.

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
